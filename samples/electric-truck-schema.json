{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/electric-truck.schema.json",
  "title": "Electric Truck Telemetry and Operations Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fleetId", "truck", "telematics", "routes", "maintenance"],
  "properties": {
    "fleetId": {
      "type": "string",
      "minLength": 3
    },
    "truck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truckId",
        "vin",
        "manufacturer",
        "model",
        "manufacturingYear",
        "isAutonomousReady",
        "decommissionedAt",
        "grossVehicleWeightKg",
        "battery",
        "dimensions",
        "axleLoads",
        "tags",
        "ecoModes"
      ],
      "properties": {
        "truckId": { "type": "string" },
        "vin": { "type": "string", "minLength": 17, "maxLength": 17 },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "manufacturingYear": { "type": "integer", "minimum": 2010, "maximum": 2100 },
        "isAutonomousReady": { "type": "boolean" },
        "decommissionedAt": { "type": "null" },
        "grossVehicleWeightKg": { "type": "number", "exclusiveMinimum": 0 },
        "battery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacityKwh", "stateOfChargePct", "packChemistry", "cellVoltages", "temperatureMatrixC"],
          "properties": {
            "capacityKwh": { "type": "number", "exclusiveMinimum": 0 },
            "stateOfChargePct": { "type": "number", "minimum": 0, "maximum": 100 },
            "packChemistry": { "type": "string", "enum": ["LFP", "NMC", "LMFP"] },
            "cellVoltages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number" }
            },
            "temperatureMatrixC": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number" }
              }
            }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lengthM", "widthM", "heightM"],
          "properties": {
            "lengthM": { "type": "number", "exclusiveMinimum": 0 },
            "widthM": { "type": "number", "exclusiveMinimum": 0 },
            "heightM": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "axleLoads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axle", "loadKg", "tirePressuresPsi"],
            "properties": {
              "axle": { "type": "integer", "minimum": 1 },
              "loadKg": { "type": "number", "exclusiveMinimum": 0 },
              "tirePressuresPsi": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "minimum": 50, "maximum": 150 }
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ecoModes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modeName", "maxSpeedKph", "regenLevel"],
            "properties": {
              "modeName": { "type": "string" },
              "maxSpeedKph": { "type": "integer", "minimum": 30, "maximum": 130 },
              "regenLevel": { "type": "integer", "minimum": 0, "maximum": 5 }
            }
          }
        }
      }
    },
    "telematics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestampUtc", "location", "speedKph", "odometerKm", "activeFaultCodes", "driver"],
      "properties": {
        "timestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon", "altitudeM"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "altitudeM": { "type": "number" }
          }
        },
        "speedKph": { "type": "number", "minimum": 0, "maximum": 140 },
        "odometerKm": { "type": "number", "minimum": 0 },
        "activeFaultCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driverId", "name", "hoursDrivenToday", "isHazmatCertified"],
          "properties": {
            "driverId": { "type": "string" },
            "name": { "type": "string" },
            "hoursDrivenToday": { "type": "number", "minimum": 0, "maximum": 24 },
            "isHazmatCertified": { "type": "boolean" }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routeId", "stops"],
        "properties": {
          "routeId": { "type": "string" },
          "stops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sequence", "siteCode", "scheduledArrivalUtc", "payload"],
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "siteCode": { "type": "string" },
                "scheduledArrivalUtc": { "type": "string", "format": "date-time" },
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["totalMassKg", "containers"],
                  "properties": {
                    "totalMassKg": { "type": "number", "minimum": 0 },
                    "containers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["containerId", "contentType", "temperatureSetpointC"],
                        "properties": {
                          "containerId": { "type": "string" },
                          "contentType": { "type": "string" },
                          "temperatureSetpointC": {
                            "type": ["number", "null"]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastServiceDate", "nextServiceDueKm", "tasks"],
      "properties": {
        "lastServiceDate": { "type": "string", "format": "date" },
        "nextServiceDueKm": { "type": "integer", "minimum": 0 },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskCode", "priority", "completed", "notes"],
            "properties": {
              "taskCode": { "type": "string" },
              "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
              "completed": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
